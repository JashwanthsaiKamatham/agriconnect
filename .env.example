# ---------------------------------------------------------------------------
# AgriConnect environment variables (PLACEHOLDERS ONLY — no real secrets here)
# Copy this file to `.env.local` and fill in your own values.
# Never commit `.env.local` to version control.
# ---------------------------------------------------------------------------

# Database (used when the app is connected to a real backend)
DATABASE_URL=your_database_connection_string

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_auth_secret

# Weather API (e.g. OpenWeatherMap / IMD / Weather.com)
WEATHER_API_KEY=your_weather_api_key
NEXT_PUBLIC_WEATHER_API_BASE_URL=https://api.weather.example.com/v1

# Live market prices (e.g. Agmarknet / data.gov.in)
MARKET_PRICE_API_KEY=your_market_price_api_key
NEXT_PUBLIC_MARKET_PRICE_API_BASE_URL=https://api.market.example.com/v1

# Map provider (e.g. Google Maps / MapmyIndia / OpenStreetMap)
NEXT_PUBLIC_MAPS_API_KEY=your_maps_api_key

# AI crop disease detection service
AI_DISEASE_API_KEY=your_ai_disease_api_key
NEXT_PUBLIC_DISEASE_API_BASE_URL=https://api.disease.example.com/v1

# SMS / WhatsApp notifications (e.g. Twilio / Gupshup / MSG91)
SMS_API_KEY=your_sms_api_key
WHATSAPP_API_KEY=your_whatsapp_api_key

# Payment gateway (e.g. Razorpay / Stripe)
PAYMENT_GATEWAY_KEY=your_payment_gateway_key

# ---------------------------------------------------------------------------
# Safety notes:
# - Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
#   NEVER put a secret in a NEXT_PUBLIC_ variable.
# - Server-only keys (no prefix) are safe for database/auth/SMS/payment secrets.
# - On Vercel, add these in Project Settings → Environment Variables and use
#   encrypted values; never commit `.env.local`.
# ---------------------------------------------------------------------------
